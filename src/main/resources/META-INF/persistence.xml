<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence 
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    
    <persistence-unit name="OrgPU" transaction-type="JTA">
        <jta-data-source>jdbc/OrgDS</jta-data-source>
        
        <class>com.shakilpatel.org.entity.Organization</class>
        <class>com.shakilpatel.org.entity.ApprovalWorkflow</class>
        <class>com.shakilpatel.org.entity.OrganizationAudit</class>
        <class>com.shakilpatel.org.entity.LocalDateTimeConverter</class>


        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="eclipselink.logging.level" value="FINE"/>
            <property name="eclipselink.logging.parameters" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
